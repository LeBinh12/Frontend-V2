generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StaticContent {
  id        String   @id @default(uuid())
  key       String   @unique
  contentEn String   @map("content_en")
  contentVn String   @map("content_vn")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("static_content")
}

model Service {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  icon          String
  titleEn       String   @map("title_en")
  titleVn       String   @map("title_vn")
  descriptionEn String   @map("description_en")
  descriptionVn String   @map("description_vn")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  showOnHome    Boolean  @default(false) @map("show_on_home")
  sortOrder     Int      @default(0) @map("sort_order")

  @@map("services")
}

model TechnologyCategory {
  id        Int          @id @default(autoincrement())
  nameEn    String       @unique @map("name_en")
  nameVn    String       @unique @map("name_vn")
  name      String?      
  key       String?      @unique
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  items     Technology[]

  @@map("technology_categories")
}

model Technology {
  id         Int                 @id @default(autoincrement())
  name       String
  category   String?
  categoryId Int?                @map("category_id")
  cat        TechnologyCategory? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime            @default(now()) @map("created_at")

  @@map("technologies")
}

model PortfolioItem {
  id            Int      @id @default(autoincrement())
  key           String?  @unique
  titleEn       String   @map("title_en")
  titleVn       String   @map("title_vn")
  descriptionEn String   @map("description_en")
  descriptionVn String   @map("description_vn")
  image         String
  categoryKey   String?  @map("category_key")
  categoryId    Int?     @map("category_id")
  category      PortfolioCategory? @relation(fields: [categoryId], references: [id])
  technologies  String[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  showOnHome    Boolean  @default(false) @map("show_on_home")
  sortOrder     Int      @default(0) @map("sort_order")
  contentEn     String?  @map("content_en")
  contentVn     String?  @map("content_vn")
  duration      String?  @default("")

  @@map("portfolio_items")
}

model PortfolioCategory {
  id        Int             @id @default(autoincrement())
  nameEn    String          @unique @map("name_en")
  nameVn    String          @unique @map("name_vn")
  name      String?         
  key       String?         @unique
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  items     PortfolioItem[]

  @@map("portfolio_categories")
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  name      String
  roleEn    String   @map("role_en")
  roleVn    String   @map("role_vn")
  bioEn     String?  @map("bio_en")
  bioVn     String?  @map("bio_vn")
  avatar    String?
  level     Int      @default(3)
  top       String?
  right     String?
  size      Int?
  delay     Float?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("team_members")
}

model CompanyInfo {
  id          Int      @id @default(1)
  name        String
  tagline     String?
  email       String?
  phone       String?
  addressEn   String?  @map("address_en")
  addressVn   String?  @map("address_vn")
  officeImage String?  @map("office_image")
  teamImage   String?  @map("team_image")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("company_info")
}

model Stat {
  id       Int     @id @default(autoincrement())
  key      String  @unique
  labelEn  String  @map("label_en")
  labelVn  String  @map("label_vn")
  value    String
  detailEn String? @map("detail_en")
  detailVn String? @map("detail_vn")

  @@map("stats")
}

model Manager {
  id        String          @id @default(uuid())
  username  String          @unique
  password  String
  fullName  String?         @map("full_name")
  email     String?         @unique
  role      ManagerRole     @default(STAFF)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  roles     ManagerOnRole[]

  @@map("managers")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contacts")
}

enum ManagerRole {
  ADMIN
  MANAGER
  STAFF
}

model Role {
  id                String             @id @default(uuid())
  name              String             @unique
  descriptionEn     String?            @map("description_en")
  descriptionVn     String?            @map("description_vn")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  managers          ManagerOnRole[]
  modulePermissions ModulePermission[]

  @@map("roles")
}

model Module {
  id                String             @id @default(uuid())
  nameEn            String             @map("name_en")
  nameVn            String             @map("name_vn")
  code              String             @unique
  descriptionEn     String?            @map("description_en")
  descriptionVn     String?            @map("description_vn")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  modulePermissions ModulePermission[]

  @@map("modules")
}

model Permission {
  id                String             @id @default(uuid())
  nameEn            String             @map("name_en")
  nameVn            String             @map("name_vn")
  code              String             @unique
  descriptionEn     String?            @map("description_en")
  descriptionVn     String?            @map("description_vn")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  modulePermissions ModulePermission[]

  @@map("permissions")
}

model ModulePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  moduleId     String     @map("module_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([roleId, moduleId, permissionId])
  @@map("module_permissions")
}

model ManagerOnRole {
  managerId String  @map("manager_id")
  roleId    String  @map("role_id")
  manager   Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([managerId, roleId])
  @@map("manager_roles")
}
