{
  "name": "landing-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node --project scripts/tsconfig.json scripts/db-setup.ts && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "prisma db push && prisma db seed",
    "db:push": "prisma db push --accept-data-loss",
    "db:setup": "ts-node --project scripts/tsconfig.json scripts/db-setup.ts"
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@fullpage/react-fullpage": "^0.1.49",
    "@prisma/client": "^6.4.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/three": "^0.182.0",
    "ag-grid-community": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.25.0",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "lenis": "^1.3.17",
    "lucide-react": "^0.562.0",
    "maath": "^0.10.8",
    "next": "16.1.1",
    "nodemailer": "^7.0.12",
    "prisma": "^6.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.3",
    "react-icons": "^5.5.0",
    "react-quill-new": "^3.8.3",
    "rsuite": "^6.1.1",
    "sass": "^1.97.2",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
